    "job_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "params_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "pii_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
