{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "name",
    "version",
    "entrypoint"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "critical": {
      "type": "boolean"
    },
    "timeout_sec": {
      "type": "integer",
      "minimum": 1
    },
    "default_params": {
      "type": "object",
      "additionalProperties": true
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}