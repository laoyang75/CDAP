{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-quality-v1.schema.json",
  "type": "object",
  "required": [
    "row_count_total",
    "table_row_counts",
    "missing_rate_by_column",
    "schema_mismatch",
    "warnings"
  ],
  "properties": {
    "row_count_total": {
      "type": "integer",
      "minimum": 0
    },
    "table_row_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "missing_rate_by_column": {
      "type": "object",
      "additionalProperties": true
    },
    "schema_mismatch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}